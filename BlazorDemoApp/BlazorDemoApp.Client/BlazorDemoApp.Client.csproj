<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <NoDefaultLaunchSettingsFile>true</NoDefaultLaunchSettingsFile>
    <StaticWebAssetProjectMode>Default</StaticWebAssetProjectMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" Version="10.0.10" />
  </ItemGroup>

  <!-- Zadanie inline liczące wersję dnia -->
  <UsingTask TaskName="AutoIncrementDailyVersion" TaskFactory="RoslynCodeTaskFactory" AssemblyFile="$(MSBuildToolsPath)\Microsoft.Build.Tasks.Core.dll">
    <ParameterGroup>
      <CounterFile ParameterType="System.String" Required="true" />
      <ResultVersion ParameterType="System.String" Output="true" />
    </ParameterGroup>
    <Task>
      <Using Namespace="System" />
      <Using Namespace="System.IO" />
      <Code Type="Fragment" Language="cs">
        <![CDATA[
          DateTime now = DateTime.UtcNow;
          string todayStr = now.ToString("yyyyMMdd");
          int counter = 1;

          if (File.Exists(CounterFile))
          {
              string content = File.ReadAllText(CounterFile).Trim();
              string[] parts = content.Split(':');
              if (parts.Length == 2 && parts[0] == todayStr && int.TryParse(parts[1], out int lastCounter))
              {
                  counter = lastCounter + 1;
              }
          }

          File.WriteAllText(CounterFile, todayStr + ":" + counter);

          string yyMM = now.ToString("yyMM");
          int dd = now.Day;
          int revision = dd * 1000 + counter;

          ResultVersion = "1.0." + yyMM + "." + revision;
        ]]>
      </Code>
    </Task>
  </UsingTask>

  <Target Name="GenerateDailyVersion" BeforeTargets="BeforeCompile;CoreCompile;GetAssemblyVersion;GenerateAssemblyInfo">
    <AutoIncrementDailyVersion CounterFile="$(MSBuildProjectDirectory)\..\BlazorDemoApp\.build_counter.txt">
      <Output TaskParameter="ResultVersion" PropertyName="Version" />
    </AutoIncrementDailyVersion>

    <PropertyGroup>
      <AssemblyVersion>$(Version)</AssemblyVersion>
      <FileVersion>$(Version)</FileVersion>
      <InformationalVersion>$(Version)</InformationalVersion>
    </PropertyGroup>
  </Target>

</Project>