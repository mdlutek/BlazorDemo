@code {
    private string appVersion = "1.0.0";
    private bool isPostgresOpen = false;

    protected override void OnInitialized()
    {
        var version = typeof(NavMenu).Assembly.GetName().Version;
        if (version != null)
        {
            appVersion = version.ToString();
        }

        // Sprawdź trasę przy starcie
        CheckActiveRoute();
        // Nasłuchuj na zmiany podstron
        Navigation.LocationChanged += OnLocationChanged;
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        CheckActiveRoute();
        StateHasChanged();
    }

    private void CheckActiveRoute()
    {
        var relativePath = Navigation.ToBaseRelativePath(Navigation.Uri);

        // Jeśli jesteśmy na podstronie PostgreSQL (np. 'postgres' lub 'postgres/products') -> otwórz submenu
        if (relativePath.StartsWith("postgres", StringComparison.OrdinalIgnoreCase))
        {
            isPostgresOpen = true;
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocationChanged;
    }
}