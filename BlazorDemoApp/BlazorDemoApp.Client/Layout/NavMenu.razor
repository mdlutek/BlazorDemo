    <!-- Stopka z wersją -->
    <div class="nav-footer px-3 py-2 border-top border-secondary text-center">
        <small class="text-white-50">
            Wersja: <span class="badge bg-secondary">v@(appVersion)</span>
        </small>
    </div>

