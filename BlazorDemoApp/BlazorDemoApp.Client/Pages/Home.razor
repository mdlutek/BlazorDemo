@page "/"
@rendermode InteractiveWebAssembly

<PageTitle>Azure & Cloud Showcase - Blazor Demo</PageTitle>

<div class="container mt-4 mb-5">
    <!-- Hero Header -->
    <div class="p-4 p-md-5 mb-4 rounded-3 bg-light border shadow-sm">
        <div class="container-fluid py-2">
            <div class="d-flex justify-content-between align-items-start flex-wrap gap-3">
                <div>
                    <h1 class="display-5 fw-bold text-primary">🚀 Cloud & Full-Stack Demo</h1>
                    <p class="col-md-9 fs-5 text-muted">
                        Aplikacja demonstracyjna prezentująca architekturę mikroserwisów i chmury Microsoft Azure w ekosystemie <strong>.NET / Blazor</strong>.
                    </p>
                </div>
                <a href="https://github.com/mdlutek/BlazorDemo"
                   target="_blank"
                   rel="noopener noreferrer"
                   class="btn btn-dark btn-lg d-inline-flex align-items-center gap-2 shadow">
                    <svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" fill="currentColor" viewBox="0 0 16 16">
                        <path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8" />
                    </svg>
                    <span>Zobacz na GitHub</span>
                </a>
            </div>

            <!-- Tagi Technologiczne -->
            <div class="d-flex flex-wrap gap-2 mt-3">
                <span class="badge bg-primary">Blazor Web App</span>
                <span class="badge bg-info text-dark">Azure App Service (Linux)</span>
                <span class="badge bg-primary">Azure SQL Database</span>
                <span class="badge bg-primary" style="background-color: #336791 !important;">PostgreSQL (Serverless & JSONB)</span>
                <span class="badge bg-info text-dark">Azure Cosmos DB (NoSQL)</span>
                <span class="badge bg-warning text-dark">Azure Functions (Timer Cron)</span>
                <span class="badge bg-success">MongoDB Atlas (NoSQL)</span>
                <span class="badge bg-secondary">Entity Framework Core</span>
                <span class="badge bg-dark">WebAssembly</span>
            </div>
        </div>
    </div>

    <!-- Kafelki Modułów Aplikacji -->
    <h3 class="mb-3 fw-bold">Moduły demonstracyjne</h3>
    <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4 mb-5">

        <!-- Karta 1: Azure SQL (ToDo & Big Data Grid) -->
        <div class="col">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="card-title text-primary mb-0">🔷 Azure SQL</h4>
                            <span class="badge bg-primary">10 000+ Rows</span>
                        </div>
                        <p class="card-text text-muted">
                            Relacyjna baza <strong>Azure SQL Database</strong> z paginacją serwerową <code>Skip/Take</code>, filtrowaniem transakcji oraz codziennym czyszczeniem zadań przez <strong>Azure Functions</strong>.
                        </p>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <a href="azuresql/transactions" class="btn btn-primary w-50">Data Grid &rarr;</a>
                        <a href="todo" class="btn btn-outline-primary w-50">ToDo List &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Karta 2: PostgreSQL (Products & JSONB) -->
        <div class="col">
            <div class="card h-100 shadow-sm border-primary" style="border-color: #336791 !important;">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="card-title mb-0" style="color: #336791;">🐘 PostgreSQL</h4>
                            <span class="badge" style="background-color: #336791;">JSONB & Triggers</span>
                        </div>
                        <p class="card-text text-muted">
                            Katalog produktów i kategorii oparty o <strong>PostgreSQL (Neon Serverless)</strong>. Prezentuje relacje PK/FK, natywne tablice <code>text[]</code>, kolumny <strong>JSONB</strong> oraz wyzwalacze audytu (<strong>Triggers</strong>).
                        </p>
                    </div>
                    <div class="d-flex gap-2 mt-3">
                        <a href="postgres/products" class="btn btn-outline-primary w-50" style="color: #336791; border-color: #336791;">Produkty &rarr;</a>
                        <a href="postgres/categories" class="btn btn-outline-secondary w-50">Kategorie &rarr;</a>
                    </div>
                </div>
            </div>
        </div>

        <!-- Karta 3: Cosmos DB -->
        <div class="col">
            <div class="card h-100 shadow-sm border-info">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="card-title text-info mb-0">🪐 Cosmos DB</h4>
                            <span class="badge bg-info text-dark">Azure Cosmos DB</span>
                        </div>
                        <p class="card-text text-muted">
                            Dziennik wpisów w natywnej bazie dokumentowej <strong>Azure Cosmos DB for NoSQL</strong> z obsługą <strong>Klucza Partycji (/category)</strong> i zapytaniami SQL w JSON.
                        </p>
                    </div>
                    <a href="cosmosdb" class="btn btn-outline-info mt-3 w-100">Otwórz Cosmos DB &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Karta 4: MongoDB -->
        <div class="col">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="card-title text-success mb-0">🍃 MongoDB NoSQL</h4>
                            <span class="badge bg-success">MongoDB Atlas</span>
                        </div>
                        <p class="card-text text-muted">
                            Katalog produktów w nierelacyjnej bazie dokumentowej hostowanej w chmurze <strong>MongoDB Atlas (Azure)</strong>. Pokazuje obsługę zagnieżdżonych tablic i dokumentów BSON/JSON.
                        </p>
                    </div>
                    <a href="mongodb" class="btn btn-outline-success mt-3 w-100">Otwórz MongoDB &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Karta 5: FizzBuzz -->
        <div class="col">
            <div class="card h-100 shadow-sm border-secondary">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="card-title text-secondary mb-0">🔢 FizzBuzz</h4>
                            <span class="badge bg-dark">WebAssembly</span>
                        </div>
                        <p class="card-text text-muted">
                            Algorytm działający w 100% po stronie przeglądarki klienta (<strong>Blazor WebAssembly</strong>) z zerowym narzutem sieciowym na serwer w chmurze.
                        </p>
                    </div>
                    <a href="fizzbuzz" class="btn btn-outline-secondary mt-3 w-100">Otwórz FizzBuzz &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Karta 6: Password Analyzer WASM -->
        <div class="col">
            <div class="card h-100 shadow-sm border-success">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="card-title text-success mb-0">🔒 Password Analyzer</h4>
                            <span class="badge bg-success">WASM Security</span>
                        </div>
                        <p class="card-text text-muted">
                            Analizator siły haseł obliczający entropię matematyczną, szacujący czas złamania metodą Brute-Force oraz generator haseł fonetycznych w 100% po stronie przeglądarki.
                        </p>
                    </div>
                    <a href="counter" class="btn btn-outline-success mt-3 w-100">Otwórz Analizator &rarr;</a>
                </div>
            </div>
        </div>

        <!-- Karta 7: Weather -->
        <div class="col">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <h4 class="card-title text-primary mb-0">⛅ Weather</h4>
                            <span class="badge bg-primary">Live REST API</span>
                        </div>
                        <p class="card-text text-muted">
                            Stacja pogodowa na żywo pobierająca dane meteorologiczne, historię z wczoraj oraz prognozy dla miast w Polsce z otwartego API <strong>Open-Meteo</strong>.
                        </p>
                    </div>
                    <a href="weather" class="btn btn-outline-primary mt-3 w-100">Otwórz Pogodę &rarr;</a>
                </div>
            </div>
        </div>

    </div>

    <!-- Architektura Chmurowa -->
    <div class="card shadow-sm border-0 bg-light p-3">
        <div class="card-body">
            <h4 class="fw-bold mb-3">☁️ Architektura środowiska chmurowego</h4>
            <ul class="mb-0 text-muted">
                <li><strong>Frontend & Backend:</strong> Hosting w usłudze <em>Azure App Service (Linux, Plan F1)</em> spięty z własną subdomeną <code>blazordemo.md-dev.net.pl</code>.</li>
                <li><strong>Relacyjna Baza Danych:</strong> <em>Azure SQL Database (Warstwa Basic)</em> w regionie <code>Poland Central</code> z kontrolą dostępu przez Firewall.</li>
                <li><strong>Relacyjna Baza Serverless:</strong> <em>PostgreSQL (Neon.tech w regionie Frankfurt)</em> z obsługą kolumn <code>JSONB</code>, tablic <code>text[]</code> oraz wyzwalaczy audytowych (<code>Triggers</code>).</li>
                <li><strong>Natywna Baza NoSQL:</strong> <em>Azure Cosmos DB for NoSQL (Free Tier)</em> z modelem partycjonowania <code>/category</code>.</li>
                <li><strong>Bezserwerowy Cron Job:</strong> <em>Azure Functions (Timer Trigger)</em> wykonujący codzienne automatyczne czyszczenie bazy zadań.</li>
                <li><strong>Baza NoSQL (Dokumentowa):</strong> Klaster <em>MongoDB Atlas (M0 Sandbox)</em> w chmurze Microsoft Azure.</li>
            </ul>
        </div>
    </div>
</div>