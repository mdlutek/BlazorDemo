@page "/cosmosdb"
@using BlazorDemoApp.Models
@using Microsoft.Azure.Cosmos
@inject CosmosClient CosmosClient
@inject ILogger<CosmosDemo> Logger
@rendermode InteractiveServer //@(new InteractiveServerRenderMode(prerender: false))

<PageTitle>Azure Cosmos DB Demo</PageTitle>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div>
            <h1>🪐 Azure Cosmos DB (NoSQL)</h1>
            <p class="text-muted mb-0">
                Natywna, globalnie rozproszona baza dokumentowa Microsoftu z obsługą <strong>Partition Key (/category)</strong>.
            </p>
        </div>
        <span class="badge bg-info text-dark fs-6 px-3 py-2">Cosmos DB for NoSQL</span>
    </div>

    <hr />

    <!-- Formularz dodawania notatki -->
    <div class="card shadow-sm mb-4 col-md-8 col-lg-6">
        <div class="card-body">
            <h5 class="card-title mb-3">Dodaj wpis do kontenera Cosmos DB</h5>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    <strong>Uwaga!</strong> @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            <div class="mb-2">
                <label class="form-label small text-muted">Kategoria (Klucz partycji / Partition Key):</label>
                <select class="form-select" @bind="newCategory">
                    <option value="Azure">Azure</option>
                    <option value="Architektura">Architektura</option>
                    <option value="DevOps">DevOps</option>
                    <option value="Bezpieczeństwo">Bezpieczeństwo</option>
                    <option value="Ogólne">Ogólne</option>
                </select>
            </div>

            <div class="mb-2">
                <label class="form-label small text-muted">Tytuł wpisu * (maks. 50 znaków):</label>
                <input type="text" class="form-control" placeholder="np. Wdrożenie mikroserwisów" @bind="newTitle" maxlength="50" />
            </div>

            <div class="mb-2">
                <label class="form-label small text-muted">Treść / Szczegóły (maks. 150 znaków):</label>
                <textarea class="form-control" rows="2" placeholder="Krótki opis zdarzenia..." @bind="newContent" maxlength="150"></textarea>
            </div>

            <div class="mb-3">
                <label class="form-label small text-muted">Priorytet:</label>
                <select class="form-select" @bind="newPriority">
                    <option value="Low">Niski (Low)</option>
                    <option value="Medium">Średni (Medium)</option>
                    <option value="High">Wysoki (High)</option>
                </select>
            </div>

            <button class="btn btn-primary" @onclick="AddNote" disabled="@(notes != null && notes.Count >= 10)">
                Zapisz dokument w Cosmos DB
            </button>
            <small class="text-muted d-block mt-1">Liczba dokumentów: @(notes?.Count ?? 0) / 10</small>
        </div>
    </div>

    <!-- Lista wpisów z Cosmos DB -->
    <h3 class="mb-3">Dokumenty w kontenerze:</h3>
    @if (isLoading || notes == null)
    {
        <div class="d-flex align-items-center gap-2 p-4 bg-light rounded border mb-3 text-muted">
            <div class="spinner-border spinner-border-sm text-info" role="status"></div>
            <span>Pobieranie dokumentów z Azure Cosmos DB...</span>
        </div>
    }
    else if (!notes.Any())
    {
        <div class="alert alert-info col-md-8 col-lg-6">
            Brak wpisów w kontenerze. Dodaj pierwszą notatkę powyżej!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var note in notes)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm border-info">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h5 class="card-title text-primary mb-0 text-break" style="min-width: 0;">
                                        @note.Title
                                    </h5>
                                    <span class="badge @GetPriorityBadge(note.Priority) flex-shrink-0">
                                        @note.Priority
                                    </span>
                                </div>

                                <div class="mb-2">
                                    <span class="badge bg-secondary">📁 /@note.Category</span>
                                </div>

                                <p class="card-text text-muted small text-break">
                                    @note.Content
                                </p>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <small class="text-muted text-nowrap">@note.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                <button class="btn btn-outline-danger btn-sm flex-shrink-0" @onclick="() => DeleteNote(note.Id, note.Category)">
                                    Usuń
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private Container? container;
    private List<CosmosNote>? notes;
    private bool isLoading = true; // Flaga stanu ładowania w tle
    private string newCategory = "Azure";
    private string newTitle = string.Empty;
    private string newContent = string.Empty;
    private string newPriority = "Medium";
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        // 1. Nie blokujemy metody - strona pojawia się natychmiast (w 0 ms)
        _ = LoadNotesInBackgroundAsync();
        await Task.CompletedTask;
    }

    private async Task LoadNotesInBackgroundAsync()
    {
        isLoading = true;
        try
        {
            // Uzyskujemy dostęp do bazy 'CosmosDemoDb' i kontenera 'Notes'
            container ??= CosmosClient.GetContainer("CosmosDemoDb", "Notes");
            await LoadNotes();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd inicjalizacji połączenia z Cosmos DB");
            errorMessage = "Nie udało się połączyć z Azure Cosmos DB.";
            notes = new List<CosmosNote>();
        }
        finally
        {
            isLoading = false;
            // 2. Bezpiecznie powiadamiamy wątek UI o nadejściu danych
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadNotes()
    {
        if (container == null) return;

        try
        {
            // Zapytanie SQL do bazy NoSQL w Cosmos DB
            var query = new QueryDefinition("SELECT * FROM c ORDER BY c.createdAt DESC");
            using var feedIterator = container.GetItemQueryIterator<CosmosNote>(query);

            var items = new List<CosmosNote>();
            while (feedIterator.HasMoreResults)
            {
                var response = await feedIterator.ReadNextAsync();
                items.AddRange(response);
            }

            notes = items;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd pobierania danych z Cosmos DB");
            errorMessage = "Nie udało się pobrać danych z Cosmos DB.";
            notes = new List<CosmosNote>();
        }
    }

    private async Task AddNote()
    {
        errorMessage = string.Empty;

        if (string.IsNullOrWhiteSpace(newTitle))
        {
            errorMessage = "Pole „Tytuł wpisu” jest wymagane!";
            return;
        }

        if (container == null) return;

        try
        {
            if (notes != null && notes.Count >= 10)
            {
                errorMessage = "Osiągnięto limit 10 dokumentów demo! Usuń wcześniejsze wpisy.";
                return;
            }

            var note = new CosmosNote
            {
                Id = Guid.NewGuid().ToString(),
                Category = newCategory,
                Title = newTitle.Trim(),
                Content = newContent.Trim(),
                Priority = newPriority,
                CreatedAt = DateTime.UtcNow
            };

            // Zapis z uwzględnieniem Klucza Partycji (Partition Key)
            await container.CreateItemAsync(note, new PartitionKey(note.Category));

            newTitle = string.Empty;
            newContent = string.Empty;

            await LoadNotes();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd dodawania dokumentu do Cosmos DB");
            errorMessage = "Wystąpił błąd podczas zapisu w Cosmos DB.";
        }
    }

    private async Task DeleteNote(string id, string category)
    {
        if (container == null) return;

        try
        {
            // Usunięcie wymaga podania ID oraz Klucza Partycji!
            await container.DeleteItemAsync<CosmosNote>(id, new PartitionKey(category));
            await LoadNotes();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd usuwania dokumentu z Cosmos DB");
            errorMessage = "Nie udało się usunąć dokumentu.";
        }
    }

    private string GetPriorityBadge(string priority) => priority switch
    {
        "High" => "bg-danger",
        "Medium" => "bg-warning text-dark",
        "Low" => "bg-success",
        _ => "bg-secondary"
    };
}