@page "/itsm-agent"
@using BlazorDemoApp.Models
@inject HttpClient Http
@inject IConfiguration Configuration
@inject ILogger<ItsmAgent> Logger
@rendermode InteractiveServer //@(new InteractiveServerRenderMode(prerender: false))

<PageTitle>ITSM AI Agent Demo</PageTitle>

<div class="container mt-4 mb-5">
    <!-- Spójny nagłówek z Twojego szablonu -->
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div>
            <h1>🤖 ITSM AI Copilot</h1>
            <p class="text-muted mb-0">
                Autonomiczny agent pierwszej linii wsparcia z mechanizmem <strong>RAG</strong> oraz <strong>Tool Calling</strong> (Azure OpenAI + Cosmos DB).
            </p>
        </div>
        <span class="badge bg-primary fs-6 px-3 py-2">Azure OpenAI & RAG</span>
    </div>

    <hr />

    <!-- Baner błędów w Twoim stylu -->
    @if (!string.IsNullOrEmpty(errorMessage))
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <strong>Uwaga!</strong> @errorMessage
            <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
        </div>
    }

    <div class="row g-4">
        <!-- LEWA KOLUMNA: CZAT Z AGENTEM AI -->
        <div class="col-lg-6">
            <div class="card h-100 shadow-sm border-primary">
                <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center py-2">
                    <span class="fw-bold">💬 Rozmowa z Agentem Helpdesku</span>
                    <span class="badge bg-light text-primary">Model: gpt-4.1-mini</span>
                </div>

                <div class="card-body d-flex flex-column justify-content-between" style="min-height: 520px;">
                    <!-- Okno wiadomości z przewijaniem -->
                    <div class="flex-grow-1 overflow-auto pe-2 mb-3" style="max-height: 420px; display: flex; flex-direction: column; gap: 10px;">
                        @if (!messages.Any())
                        {
                            <div class="text-center text-muted my-auto p-4">
                                <p class="mb-2">Opisz problem techniczny lub kliknij gotowy test:</p>
                                <div class="d-flex flex-column gap-2">
                                    <button class="btn btn-outline-primary btn-sm text-start" @onclick="@(() => QuickPrompt("Mam błąd 800 na VPN, nie mogę się połączyć. Co robić?"))">
                                        🔍 <strong>Test RAG:</strong> Błąd 800 VPN (wyszukanie w Cosmos DB)
                                    </button>
                                    <button class="btn btn-outline-danger btn-sm text-start" @onclick="@(() => QuickPrompt("Restart nie pomógł. Załóż pilny ticket na awarię VPN do działu Network."))">
                                        🎫 <strong>Test Tool Calling:</strong> Załóż zgłoszenie w systemie
                                    </button>
                                </div>
                            </div>
                        }

                        @foreach (var msg in messages)
                        {
                            <div class="d-flex @(msg.IsUser ? "justify-content-end" : "justify-content-start")">
                                <div class="p-3 rounded-3 @(msg.IsUser ? "bg-primary text-white" : "bg-light border")"
                                     style="max-width: 85%; white-space: pre-wrap;">
                                    <div class="d-flex justify-content-between align-items-center gap-3 mb-1">
                                        <small class="fw-bold @(msg.IsUser ? "text-white-50" : "text-primary")">
                                            @(msg.IsUser ? "Użytkownik" : "🤖 Agent ITSM")
                                        </small>
                                        <small class="@(msg.IsUser ? "text-white-50" : "text-muted")" style="font-size: 0.75rem;">
                                            @msg.Time.ToString("HH:mm")
                                        </small>
                                    </div>
                                    <div class="text-break">@msg.Text</div>
                                </div>
                            </div>
                        }

                        @if (isSending)
                        {
                            <div class="d-flex justify-content-start">
                                <div class="p-3 rounded-3 bg-light border text-muted d-flex align-items-center gap-2">
                                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                                    <span><em>Agent weryfikuje bazę wiedzy i analizuje zapytanie...</em></span>
                                </div>
                            </div>
                        }
                    </div>

                    <!-- Pole wprowadzania z walidacją 250 znaków -->
                    <div>
                        <div class="input-group">
                            <input type="text" class="form-control" placeholder="Opisz problem (maks. 250 znaków)..."
                                   @bind="userInput" @bind:event="oninput" @onkeyup="HandleKeyUp" maxlength="250" disabled="@isSending" />
                            <button class="btn btn-primary" @onclick="SendMessage" disabled="@(isSending || string.IsNullOrWhiteSpace(userInput))">
                                Wyślij
                            </button>
                        </div>
                        <small class="text-muted d-block mt-1">Znaki: @(userInput?.Length ?? 0) / 250 | Ochrona Rate Limiting</small>
                    </div>
                </div>
            </div>
        </div>

        <!-- PRAWA KOLUMNA: LISTA ZGŁOSZEŃ Z COSMOS DB W TWOIM STYLU -->
        <div class="col-lg-6">
            <div class="d-flex justify-content-between align-items-center mb-3">
                <h4 class="mb-0">Zgłoszenia w kontenerze Tickets:</h4>
                <button class="btn btn-outline-secondary btn-sm" @onclick="LoadTickets" disabled="@isLoadingTickets">
                    🔄 Odśwież
                </button>
            </div>

            @if (isLoadingTickets)
            {
                <div class="d-flex align-items-center gap-2 p-4 bg-light rounded border mb-3 text-muted">
                    <div class="spinner-border spinner-border-sm text-primary" role="status"></div>
                    <span>Pobieranie zgłoszeń z Azure Cosmos DB...</span>
                </div>
            }
            else if (tickets == null || !tickets.Any())
            {
                <div class="alert alert-info">
                    Brak dokumentów w kontenerze. Poproś Agenta o utworzenie zgłoszenia!
                </div>
            }
            else
            {
                <div class="overflow-auto pe-1" style="max-height: 520px; display: flex; flex-direction: column; gap: 12px;">
                    @foreach (var ticket in tickets)
                    {
                        <div class="card shadow-sm border-primary">
                            <div class="card-body">
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h5 class="card-title text-primary mb-0 text-break" style="min-width: 0;">
                                        @ticket.Title
                                    </h5>
                                    <span class="badge @GetPriorityBadge(ticket.Priority) flex-shrink-0">
                                        @ticket.Priority
                                    </span>
                                </div>

                                <div class="d-flex flex-wrap gap-1 mb-2">
                                    <span class="badge bg-secondary">📁 /@ticket.Category</span>
                                    <span class="badge @GetStatusBadge(ticket.Status)">@ticket.Status</span>
                                    <span class="badge bg-light text-dark border">ID: <code>@ticket.Id</code></span>
                                </div>

                                <p class="card-text text-muted small mb-2 text-break">
                                    @ticket.Description
                                </p>

                                @if (!string.IsNullOrEmpty(ticket.Resolution))
                                {
                                    <div class="p-2 bg-light border-start border-success border-3 rounded small text-break mb-1">
                                        <strong class="text-success">💡 Rozwiązanie z bazy wiedzy:</strong>
                                        <div class="text-muted">@ticket.Resolution</div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                </div>
            }
        </div>
    </div>
</div>

@code {
    private List<TicketDto>? tickets;
    private List<ChatMessageModel> messages = new();
    private string userInput = string.Empty;
    private string errorMessage = string.Empty;
    private bool isLoadingTickets = true;
    private bool isSending = false;

    // Pobieranie adresu API z appsettings.json lub fallback na localhost:7215
    private string ApiBaseUrl => Configuration["ItsmApi:BaseUrl"] ?? "https://localhost:7215";

    protected override async Task OnInitializedAsync()
    {
        // Spójny wzorzec 0 ms z Twojego projektu
        _ = LoadTicketsInBackgroundAsync();
        await Task.CompletedTask;
    }

    private async Task LoadTicketsInBackgroundAsync()
    {
        isLoadingTickets = true;
        try
        {
            await LoadTickets();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd podczas inicjalizacji listy zgłoszeń ITSM");
            errorMessage = "Nie udało się połączyć z API usługi ITSM.";
            tickets = new List<TicketDto>();
        }
        finally
        {
            isLoadingTickets = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task LoadTickets()
    {
        try
        {
            tickets = await Http.GetFromJsonAsync<List<TicketDto>>($"{ApiBaseUrl}/api/chat/tickets");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd podczas pobierania zgłoszeń z API ITSM");
            errorMessage = "Błąd komunikacji z serwisem zgłoszeń.";
        }
    }

    private async Task SendMessage()
    {
        if (string.IsNullOrWhiteSpace(userInput) || isSending) return;

        errorMessage = string.Empty;
        var text = userInput.Trim();
        userInput = string.Empty;

        messages.Add(new ChatMessageModel { Text = text, IsUser = true, Time = DateTime.Now });
        isSending = true;

        try
        {
            var response = await Http.PostAsJsonAsync($"{ApiBaseUrl}/api/chat", new { Message = text });

            if (response.IsSuccessStatusCode)
            {
                var result = await response.Content.ReadFromJsonAsync<ChatReplyDto>();
                messages.Add(new ChatMessageModel
                {
                    Text = result?.Reply ?? "Brak treści odpowiedzi z modelu.",
                    IsUser = false,
                    Time = DateTime.Now
                });

                // Automatycznie odśwież listę zgłoszeń, bo model mógł utworzyć ticket w C#
                await LoadTickets();
            }
            else if ((int)response.StatusCode == 429)
            {
                errorMessage = "Osiągnięto limit zapytań (Rate Limit 5/min). Odczekaj chwilę.";
            }
            else
            {
                errorMessage = $"Serwer zwrócił błąd: {response.StatusCode}";
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd podczas wysyłania zapytania do Agenta AI");
            errorMessage = "Nie udało się wysłać zapytania do asystenta AI.";
        }
        finally
        {
            isSending = false;
        }
    }

    private async Task QuickPrompt(string prompt)
    {
        userInput = prompt;
        await SendMessage();
    }

    private async Task HandleKeyUp(KeyboardEventArgs e)
    {
        if (e.Key == "Enter")
        {
            await SendMessage();
        }
    }

    // Spójne metody pomocnicze do badge'y z Twojego szablonu
    private string GetPriorityBadge(string priority) => priority switch
    {
        "High" => "bg-danger",
        "Medium" => "bg-warning text-dark",
        "Low" => "bg-success",
        _ => "bg-secondary"
    };

    private string GetStatusBadge(string status) => status switch
    {
        "Resolved" => "bg-success",
        "Open" => "bg-primary",
        _ => "bg-secondary"
    };
}