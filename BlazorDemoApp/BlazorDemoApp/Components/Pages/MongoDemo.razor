@page "/mongodb"
@using BlazorDemoApp.Models
@using MongoDB.Driver
@inject IMongoClient MongoClient
@inject ILogger<MongoDemo> Logger
@rendermode @(new InteractiveServerRenderMode(prerender: false))

<PageTitle>MongoDB NoSQL Demo</PageTitle>

<div class="container mt-4 mb-5">
    <div class="d-flex justify-content-between align-items-center flex-wrap gap-2 mb-2">
        <div>
            <h1>🍃 MongoDB (NoSQL) Demo</h1>
            <p class="text-muted mb-0">
                Baza dokumentowa hostowana w chmurze <strong>MongoDB Atlas (Azure)</strong>.
            </p>
        </div>
        <span class="badge bg-success fs-6 px-3 py-2">NoSQL / BSON Documents</span>
    </div>

    <hr />

    <!-- Formularz dodawania produktu -->
    <div class="card shadow-sm mb-4 col-md-8 col-lg-6">
        <div class="card-body">
            <h5 class="card-title mb-3">Dodaj produkt do kolekcji MongoDB</h5>

            @if (!string.IsNullOrEmpty(errorMessage))
            {
                <div class="alert alert-danger alert-dismissible fade show" role="alert">
                    @errorMessage
                    <button type="button" class="btn-close" @onclick="() => errorMessage = string.Empty"></button>
                </div>
            }

            <div class="mb-2">
                <label class="form-label small text-muted">Nazwa produktu (maks. 50 znaków):</label>
                <input type="text" class="form-control" placeholder="np. Laptop Dell XPS" @bind="newProductName" maxlength="50" />
            </div>

            <div class="mb-2">
                <label class="form-label small text-muted">Cena (PLN):</label>
                <input type="number" step="0.01" min="0" max="999999.99" class="form-control" placeholder="np. 4999.99" @bind="newProductPrice" />
            </div>

            <div class="mb-3">
                <label class="form-label small text-muted">Tagi (oddzielone przecinkami, maks. 80 znaków):</label>
                <input type="text" class="form-control" placeholder="np. elektronika, komputer, dell" @bind="tagsInput" maxlength="80" />
            </div>

            <button class="btn btn-success" @onclick="AddProduct" disabled="@(products != null && products.Count >= 10)">
                Zapisz dokument w MongoDB
            </button>
            <small class="text-muted d-block mt-1">Liczba dokumentów: @(products?.Count ?? 0) / 10</small>
        </div>
    </div>

    <!-- Lista dokumentów z MongoDB -->
    <h3 class="mb-3">Dokumenty w kolekcji:</h3>
    @if (products == null)
    {
        <p><em>Ładowanie dokumentów z MongoDB Atlas...</em></p>
    }
    else if (!products.Any())
    {
        <div class="alert alert-info col-md-8 col-lg-6">
            Brak dokumentów w kolekcji. Dodaj pierwszy produkt powyżej!
        </div>
    }
    else
    {
        <div class="row">
            @foreach (var prod in products)
            {
                <div class="col-md-6 col-lg-4 mb-3">
                    <div class="card h-100 shadow-sm border-success">
                        <div class="card-body d-flex flex-column justify-content-between">
                            <div>
                                <!-- Nagłówek kafelka z zabezpieczeniem flexboxa -->
                                <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                                    <h5 class="card-title text-success mb-0 text-break" style="min-width: 0;">
                                        @prod.Name
                                    </h5>
                                    <span class="badge bg-dark flex-shrink-0">
                                        @prod.Price.ToString("C")
                                    </span>
                                </div>

                                <p class="text-muted small mb-2 text-truncate">ID: <code>@prod.Id</code></p>

                                <!-- Renderowanie tagów z zawijaniem wierszy -->
                                <div class="mb-2 d-flex flex-wrap gap-1">
                                    @foreach (var tag in prod.Tags)
                                    {
                                        <span class="badge bg-light text-dark border text-break text-wrap" style="max-width: 100%;">
                                            #@tag
                                        </span>
                                    }
                                </div>
                            </div>

                            <div class="d-flex justify-content-between align-items-center mt-3 pt-2 border-top">
                                <small class="text-muted text-nowrap">@prod.CreatedAt.ToLocalTime().ToString("dd.MM.yyyy HH:mm")</small>
                                <button class="btn btn-outline-danger btn-sm flex-shrink-0" @onclick="() => DeleteProduct(prod.Id)">
                                    Usuń
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>

@code {
    private IMongoCollection<MongoProduct>? collection;
    private List<MongoProduct>? products;
    private string newProductName = string.Empty;
    private decimal newProductPrice = 0;
    private string tagsInput = string.Empty;
    private string errorMessage = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var database = MongoClient.GetDatabase("DemoStore");
            collection = database.GetCollection<MongoProduct>("Products");

            await LoadProducts();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd podczas inicjalizacji połączenia z MongoDB");
            errorMessage = "Nie udało się połączyć z bazą MongoDB Atlas.";
            products = new List<MongoProduct>();
        }
    }

    private async Task LoadProducts()
    {
        if (collection == null) return;

        try
        {
            products = await collection.Find(_ => true)
                                       .SortByDescending(p => p.CreatedAt)
                                       .ToListAsync();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd podczas pobierania produktów z MongoDB");
            errorMessage = "Błąd pobierania danych.";
            products = new List<MongoProduct>();
        }
    }

    private async Task AddProduct()
    {
        errorMessage = string.Empty;
        if (string.IsNullOrWhiteSpace(newProductName) || collection == null) return;

        if (newProductPrice < 0 || newProductPrice > 999999.99m)
        {
            errorMessage = "Podaj prawidłową cenę (od 0 do 999 999.99 PLN).";
            return;
        }

        try
        {
            var count = await collection.CountDocumentsAsync(_ => true);
            if (count >= 10)
            {
                errorMessage = "Osiągnięto limit 10 dokumentów demo! Usuń wcześniejsze wpisy.";
                return;
            }

            // Przetwarzanie i obcinanie zbyt długich pojedynczych tagów
            var tagList = tagsInput
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .Select(t => t.Length > 20 ? t.Substring(0, 20) : t) // max 20 znaków na 1 tag
                .Take(6) // max 6 tagów na produkt
                .ToList();

            var product = new MongoProduct
            {
                Name = newProductName.Trim().Length > 50 ? newProductName.Trim().Substring(0, 50) : newProductName.Trim(),
                Price = newProductPrice,
                Tags = tagList,
                CreatedAt = DateTime.UtcNow
            };

            await collection.InsertOneAsync(product);

            // Czyszczenie formularza
            newProductName = string.Empty;
            newProductPrice = 0;
            tagsInput = string.Empty;

            await LoadProducts();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd podczas dodawania dokumentu do MongoDB");
            errorMessage = "Nie udało się zapisać dokumentu w MongoDB.";
        }
    }

    private async Task DeleteProduct(string? id)
    {
        if (string.IsNullOrEmpty(id) || collection == null) return;

        try
        {
            await collection.DeleteOneAsync(p => p.Id == id);
            await LoadProducts();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Błąd podczas usuwania dokumentu z MongoDB");
            errorMessage = "Nie udało się usunąć dokumentu.";
        }
    }
}