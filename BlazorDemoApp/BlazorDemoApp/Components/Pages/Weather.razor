    private string GetPollenText(double? val)
    {
        var v = val ?? 0;
        if (v == 0) return "Brak";
        if (v <= 10) return "Niskie";
        if (v <= 50) return "Średnie";
        return "Wysokie";
    }

    private string GetPollenBadge(double? val)
    {
        var v = val ?? 0;
        if (v == 0) return "bg-light text-muted border";
        if (v <= 10) return "bg-success";
        if (v <= 50) return "bg-warning text-dark";
        return "bg-danger";
    }
